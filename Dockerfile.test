FROM python:3.12.8-slim-bookworm@sha256:2199a62885a12290dc9c5be3ca0681d367576ab7bf037da120e564723292a2f0
LABEL codeflow.collector="1"
COPY validation/pytest.lock /opt/pytest.lock
RUN pip install --require-hashes --no-cache-dir -r /opt/pytest.lock && printf '[pytest]\n' > /opt/empty.ini
COPY validation/collector.py validation/container_entry.py /opt/
ENV PYTHONDONTWRITEBYTECODE=1 PYTEST_DISABLE_PLUGIN_AUTOLOAD=1 HOME=/tmp
USER 65532:65532
WORKDIR /input
ENTRYPOINT ["/usr/local/bin/python", "-I", "/opt/container_entry.py"]
